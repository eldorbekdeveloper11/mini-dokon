<!DOCTYPE html>
<html lang="uz">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Mini Do'kon — Narxlar</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,500;0,600;0,700;1,500;1,600&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#F4EEDF;--fg:#3e2723;--card:#ffffff;--accent:#e8590c;--muted:#9c8577;--border:#eee0d0;--overlay:rgba(0,0,0,.45);
  box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);
}
@media (prefers-color-scheme:dark){
  :root:not([data-theme="light"]){--bg:#1B2230;--fg:#f3e9df;--card:#2a211b;--accent:#ff922b;--muted:#a3897a;--border:#3a2f27}
}
:root[data-theme="dark"]{--bg:#1B2230;--fg:#f3e9df;--card:#2a211b;--accent:#ff922b;--muted:#a3897a;--border:#3a2f27}
*{box-sizing:border-box}
html{height:100%;scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;min-height:100%;background:var(--bg);color:var(--fg);font-family:'Manrope',system-ui,sans-serif}
#bannerWrap img{width:100%;max-height:180px;object-fit:cover;display:block;margin-top:env(safe-area-inset-top,0px)}
header{position:sticky;top:env(safe-area-inset-top,0px);background:var(--bg);padding:16px 16px 8px;text-align:center;border-bottom:1px solid var(--border);z-index:2}
header h1{margin:0;font-size:24px;font-family:'Fraunces',Georgia,serif;font-weight:600;font-style:italic}
header p{margin:4px 0 0;color:var(--muted);font-size:14px}
.controls{max-width:760px;margin:14px auto 0;padding:0 14px}
#q{width:100%;padding:12px 14px;border-radius:12px;border:1px solid var(--border);background:var(--card);color:var(--fg);font-size:16px}
.cats{display:flex;gap:8px;overflow-x:auto;padding:12px 0 4px}
.cats button{flex:none;padding:8px 14px;border-radius:999px;border:1px solid var(--border);background:var(--card);color:var(--fg);font-size:14px}
.cats button.on{background:var(--accent);color:#fff;border-color:var(--accent)}
.grid{max-width:760px;margin:6px auto 20px;padding:6px 14px;display:grid;grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:14px}
.card{background:var(--card);border:1px solid var(--border);border-radius:16px;padding:12px;text-align:center}
.tile{--c1:#ccc;--c2:#999;margin:0 auto 8px;width:84px;height:84px;perspective:300px}
.face{width:100%;height:100%;border-radius:18px;display:flex;align-items:center;justify-content:center;font-size:38px;
  background:linear-gradient(145deg,var(--c1),var(--c2));box-shadow:0 10px 18px -8px rgba(0,0,0,.35);transform:rotateX(10deg);transition:transform .15s}
.tile:active .face{transform:rotateX(0deg) scale(1.06)}
.imgface{object-fit:cover}
.card h3{margin:0 0 4px;font-size:14.5px;line-height:1.25}
.price{font-weight:700;color:var(--accent);font-size:15px;font-family:'Fraunces',Georgia,serif}
.tag{margin-top:4px;font-size:11px;color:var(--muted)}
.hide{display:none!important}
.contactsSec{max-width:760px;margin:6px auto 90px;padding:0 14px}
.sectitle{font-size:17px;margin:0 0 10px;font-family:'Fraunces',Georgia,serif;font-style:italic}
.contact{display:flex;justify-content:space-between;align-items:center;background:var(--card);border:1px solid var(--border);border-radius:12px;padding:10px 14px;margin-bottom:8px}
.contact a{color:var(--accent);font-weight:700;text-decoration:none}
.addrBtn{display:block;background:var(--card);border:1px solid var(--border);border-radius:12px;padding:12px 14px;color:var(--fg);text-decoration:none;text-align:center;margin-top:4px}
.admin-btn{position:fixed;right:16px;bottom:calc(16px + env(safe-area-inset-bottom,0px));width:52px;height:52px;border-radius:50%;
  border:0;background:var(--accent);color:#fff;font-size:22px;box-shadow:0 6px 16px rgba(0,0,0,.3);z-index:5}
.panel{position:fixed;inset:0;background:var(--overlay);z-index:10;display:flex;align-items:flex-end;justify-content:center}
.panel .box{background:var(--bg);width:100%;max-width:520px;max-height:85vh;overflow:auto;border-radius:18px 18px 0 0;
  padding:18px 16px calc(18px + env(safe-area-inset-bottom,0px))}
.panel h2{margin:0 0 6px;font-size:19px;font-family:'Fraunces',Georgia,serif;font-style:italic}
.panel h3{margin:16px 0 8px;font-size:14px;color:var(--muted);text-transform:uppercase;letter-spacing:.04em}
.row{display:flex;flex-wrap:wrap;gap:6px;align-items:center;margin-bottom:10px;border-bottom:1px solid var(--border);padding-bottom:10px}
.row input[type=text],.row input[type=tel]{flex:1;min-width:90px;padding:8px;border-radius:8px;border:1px solid var(--border);background:var(--card);color:var(--fg)}
.row input[type=number]{width:84px;padding:8px;border-radius:8px;border:1px solid var(--border);background:var(--card);color:var(--fg)}
.row select{padding:8px;border-radius:8px;border:1px solid var(--border);background:var(--card);color:var(--fg)}
.row .del{border:0;background:none;color:var(--muted);font-size:18px;padding:4px 8px}
.imgpick{display:flex;flex-direction:column;align-items:center;gap:4px;flex:none;width:64px}
.thumb{width:56px;height:56px;border-radius:12px;overflow:hidden;background:var(--border);display:flex;align-items:center;justify-content:center;font-size:22px;cursor:pointer}
.thumb img{width:100%;height:100%;object-fit:cover;display:block}
.pickbtn{display:inline-block;padding:6px 10px;border-radius:8px;background:var(--accent);color:#fff;font-size:12px;cursor:pointer;text-align:center}
.pickbtn.small{padding:4px 6px;font-size:11px}
.pickclear{border:0;background:none;color:var(--muted);font-size:11px;padding:2px 4px;text-decoration:underline}
.pickbtns{display:flex;gap:8px;align-items:center}
.bannerpick{width:100%;align-items:stretch;gap:8px}
.bannerpick .thumb{width:100%;height:90px;border-radius:12px;font-size:28px}
.bannerpick .pickbtns{justify-content:flex-start}
#addRow,#addContact{width:100%;margin:2px 0 4px;padding:10px;border-radius:10px;border:1px dashed var(--border);background:none;color:var(--fg)}
.chips{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:8px}
.chip{display:flex;align-items:center;gap:6px;padding:6px 10px;border-radius:999px;background:var(--border);font-size:13px}
.chip button{border:0;background:none;color:var(--muted);font-size:13px;padding:0;line-height:1}
.addcat{display:flex;gap:6px}
.addcat input{flex:1;padding:8px;border-radius:8px;border:1px solid var(--border);background:var(--card);color:var(--fg)}
.addcat button{padding:8px 14px;border-radius:8px;border:0;background:var(--accent);color:#fff}
#addrInput{width:100%;padding:10px;border-radius:10px;border:1px solid var(--border);background:var(--card);color:var(--fg)}
.panelActions{display:flex;gap:10px;margin-top:16px}
.panelActions button{flex:1;padding:12px;border-radius:10px;border:0;font-size:15px}
#save{background:var(--accent);color:#fff}
#close{background:var(--card);color:var(--fg);border:1px solid var(--border)}
#status{text-align:center;color:var(--muted);font-size:13px;margin-top:8px;min-height:18px}
.face{position:relative;overflow:hidden}
.face::after{content:"";position:absolute;inset:0;border-radius:18px;pointer-events:none;
  background:radial-gradient(circle at var(--mx,50%) var(--my,50%), rgba(255,255,255,.55), transparent 55%);
  opacity:0;transition:opacity .2s}
.face.glow::after{opacity:1}
@keyframes tileIn{from{opacity:0;transform:perspective(300px) rotateY(65deg) scale(.7)}to{opacity:1;transform:perspective(300px) rotateY(0deg) scale(1)}}
.tile.in{animation:tileIn .5s cubic-bezier(.22,1,.36,1) both}
@keyframes fabFloat{0%,100%{transform:translateY(0)}50%{transform:translateY(-4px)}}
.admin-btn{animation:fabFloat 2.6s ease-in-out infinite;transition:transform .15s}
.admin-btn:active{animation:none;transform:scale(.88) rotate(-14deg)}
.cats button{transition:transform .15s}
.cats button:active{transform:scale(.9)}
@keyframes popIn{0%{transform:scale(.86)}60%{transform:scale(1.08)}100%{transform:scale(1)}}
.cats button.on{animation:popIn .3s ease}
#q{transition:box-shadow .2s,transform .2s}
#q:focus{outline:none;box-shadow:0 10px 22px -8px rgba(0,0,0,.28);transform:translateY(-2px)}
.contact,.addrBtn{transition:transform .15s}
.contact:active,.addrBtn:active{transform:scale(.97)}
.ghinput{width:100%;padding:10px;border-radius:10px;border:1px solid var(--border);background:var(--card);color:var(--fg);margin-bottom:8px}
.ghNote{font-size:12px;color:var(--muted);margin:0 0 10px;line-height:1.4}
.ghBtn{width:100%;padding:12px;border-radius:10px;border:0;background:var(--accent);color:#fff;font-size:15px}
.logoutLink{display:block;text-align:center;margin-top:14px;color:var(--muted);font-size:12px;background:none;border:0;text-decoration:underline}
</style>
</head>
<body>
<div id="bannerWrap" class="hide"></div>
<header><h1>🛍️ Mini Do'kon</h1><p>Mahsulot narxlarini shu yerdan bilib oling</p></header>
<div class="controls">
<input id="q" placeholder="Mahsulot qidirish...">
<div class="cats" id="cats"></div>
</div>
<div class="grid" id="grid"></div>
<div id="contactSec" class="contactsSec hide"></div>

<button id="adminBtn" class="admin-btn hide" title="Sozlash">⚙️</button>
<div id="panel" class="panel hide"><div class="box">
<h2>Sozlamalar</h2>

<div id="credsBox">
<h3>Administrator ulanishi</h3>
<p class="ghNote">GitHub foydalanuvchi nomi, repository nomi va shaxsiy token kiriting. Bu faqat shu brauzerda saqlanadi.</p>
<input id="ghOwner" class="ghinput" placeholder="GitHub foydalanuvchi nomi">
<input id="ghRepo" class="ghinput" placeholder="Repository nomi">
<input id="ghToken" type="password" class="ghinput" placeholder="Token (ghp_... yoki github_pat_...)">
<button id="ghSave" class="ghBtn">Ulash</button>
</div>

<div id="adminBody" class="hide">
<h3>Do'kon rasmi</h3>
<div class="imgpick bannerpick"><div class="thumb" id="bannerThumb">📷</div>
<div class="pickbtns"><label class="pickbtn">Rasm tanlash<input type="file" accept="image/*" id="bannerInput" hidden></label><button type="button" class="pickclear" id="bannerClear">Olib tashlash</button></div></div>

<h3>Kategoriyalar</h3>
<div class="chips" id="catChips"></div>
<div class="addcat"><input id="newCat" placeholder="Yangi kategoriya nomi"><button id="addCatBtn">+</button></div>

<h3>Mahsulotlar</h3>
<div id="rows"></div>
<button id="addRow">+ Mahsulot qo'shish</button>

<h3>Bog'lanish</h3>
<div id="contactRows"></div>
<button id="addContact">+ Kontakt qo'shish</button>

<h3>Manzil</h3>
<input id="addrInput" placeholder="Do'kon manzili (masalan: Toshkent, Chilonzor 9)">

<div class="panelActions"><button id="save">Saqlash</button><button id="close">Yopish</button></div>
<p id="status"></p>
<button id="ghLogout" class="logoutLink">Administrator ma'lumotlarini unutish</button>
</div>
</div></div>

<script>
var STORE = {banner:"", categories:[], products:[], contacts:[], address:""};

function esc(s){ var d=document.createElement('div'); d.textContent=s||''; return d.innerHTML; }
function fmt(n){ return (n||0).toString().replace(/\B(?=(\d{3})+(?!\d))/g,' '); }
var PALETTE=[['#74c0fc','#1971c2'],['#ffd8a8','#e8590c'],['#faa2c1','#c2255c'],['#b2f2bb','#2f9e44'],['#d0bfff','#7048e8'],['#ffe066','#f08c00']];
function catColor(cat){
  var h=0, s=cat||'';
  for(var i=0;i<s.length;i++) h=(h*31+s.charCodeAt(i))>>>0;
  return PALETTE[h%PALETTE.length];
}

function readAndResize(file, cb, maxW, onErr){
  maxW = maxW || 320;
  var fail = function(){ if (onErr) onErr(); };
  var reader = new FileReader();
  reader.onerror = fail;
  reader.onload = function(e){
    var img = new Image();
    img.onerror = fail;
    img.onload = function(){
      try {
        var iw = img.naturalWidth || img.width, ih = img.naturalHeight || img.height;
        if (!iw || !ih) { fail(); return; }
        var scale = Math.min(1, maxW / Math.max(iw, ih));
        var w = Math.max(1, Math.round(iw * scale));
        var h = Math.max(1, Math.round(ih * scale));
        var cv = document.createElement('canvas');
        cv.width = w; cv.height = h;
        var ctx = cv.getContext('2d');
        ctx.fillStyle = '#ffffff';
        ctx.fillRect(0, 0, w, h);
        ctx.drawImage(img, 0, 0, w, h);
        cb(cv.toDataURL('image/jpeg', 0.78));
      } catch (err) { fail(); }
    };
    img.src = e.target.result;
  };
  reader.readAsDataURL(file);
}

var active = 'all';

function renderBanner(){
  var w = document.getElementById('bannerWrap');
  if (STORE.banner){
    w.innerHTML=''; var im=document.createElement('img'); im.src=STORE.banner; w.appendChild(im); w.classList.remove('hide');
  } else { w.classList.add('hide'); w.innerHTML=''; }
}

function renderCatButtons(){
  var el = document.getElementById('cats'); el.innerHTML='';
  var allBtn=document.createElement('button'); allBtn.textContent='Hammasi'; allBtn.dataset.cat='all';
  allBtn.className = active==='all' ? 'on' : '';
  el.appendChild(allBtn);
  STORE.categories.forEach(function(k){
    var b=document.createElement('button'); b.textContent=k; b.dataset.cat=k;
    if (k===active) b.className='on';
    el.appendChild(b);
  });
  el.querySelectorAll('button').forEach(function(b){
    b.addEventListener('click', function(){
      el.querySelectorAll('button').forEach(function(x){ x.classList.remove('on'); });
      b.classList.add('on'); active = b.dataset.cat; applyFilter();
    });
  });
}

function renderCards(){
  var g = document.getElementById('grid'); g.innerHTML='';
  STORE.products.forEach(function(p, idx){
    var c = document.createElement('div');
    c.className='card'; c.dataset.cat=p.cat||''; c.dataset.name=(p.name||'').toLowerCase();
    var col = catColor(p.cat||'');
    c.innerHTML = '<div class="tile" style="--c1:'+col[0]+';--c2:'+col[1]+'"></div>'+
      '<h3>'+esc(p.name)+'</h3><div class="price">'+fmt(p.price)+" so'm</div><div class=\"tag\">"+esc(p.cat)+'</div>';
    var tile = c.querySelector('.tile');
    tile.classList.add('in'); tile.style.animationDelay = (idx*45)+'ms';
    var fallback = function(){
      tile.innerHTML=''; var f=document.createElement('div'); f.className='face'; f.textContent='🛒'; tile.appendChild(f);
    };
    if (p.img){
      var im=document.createElement('img'); im.className='face imgface'; im.alt=p.name||''; im.decoding='async';
      im.addEventListener('error', fallback);
      im.src=p.img; tile.appendChild(im);
    } else { fallback(); }
    g.appendChild(c);
  });
  applyFilter();
  setupTilt();
}

function setupTilt(){
  document.querySelectorAll('.face').forEach(function(f){
    f.addEventListener('pointermove', function(e){
      var r = f.getBoundingClientRect();
      var x = (e.clientX - r.left) / r.width - .5;
      var y = (e.clientY - r.top) / r.height - .5;
      f.style.transform = 'rotateY(' + (x*26) + 'deg) rotateX(' + (-y*26) + 'deg) scale(1.1)';
      f.style.setProperty('--mx', ((x+.5)*100) + '%');
      f.style.setProperty('--my', ((y+.5)*100) + '%');
      f.classList.add('glow');
    });
    f.addEventListener('pointerleave', function(){ f.style.transform=''; f.classList.remove('glow'); });
  });
}

function applyFilter(){
  var q = document.getElementById('q').value.trim().toLowerCase();
  document.querySelectorAll('.card').forEach(function(c){
    var okCat = active === 'all' || c.dataset.cat === active;
    var okQ = !q || c.dataset.name.indexOf(q) !== -1;
    c.classList.toggle('hide', !(okCat && okQ));
  });
}

function renderContactSection(){
  var sec = document.getElementById('contactSec'); sec.innerHTML='';
  if (!STORE.contacts.length && !STORE.address){ sec.classList.add('hide'); return; }
  sec.classList.remove('hide');
  var h=document.createElement('h2'); h.className='sectitle'; h.textContent="📞 Bog'lanish";
  sec.appendChild(h);
  STORE.contacts.forEach(function(ct){
    var row=document.createElement('div'); row.className='contact';
    var n=document.createElement('span'); n.textContent=ct.name||'';
    var a=document.createElement('a'); a.href='tel:'+(ct.phone||'').replace(/\s+/g,''); a.textContent=ct.phone||'';
    row.appendChild(n); row.appendChild(a);
    sec.appendChild(row);
  });
  if (STORE.address){
    var link=document.createElement('a'); link.className='addrBtn'; link.target='_blank'; link.rel='noopener';
    link.href='https://www.google.com/maps/search/?api=1&query='+encodeURIComponent(STORE.address);
    link.textContent='📍 '+STORE.address;
    sec.appendChild(link);
  }
}

function renderAll(){ renderBanner(); renderCatButtons(); renderCards(); renderContactSection(); }

fetch('./data.json').then(function(r){ if(!r.ok) throw 0; return r.json(); })
  .then(function(d){ 
    STORE = d; 
    renderBanner(); 
    renderCatButtons(); 
    renderProducts(STORE.products); // Yoki mahsulotlar va boshqa qismlarni ekranga chiqaruvchi funksiyangiz qanday nomlangan bo'lsa
})
  .catch(function(){ document.getElementById('grid').innerHTML = '<p style="grid-column:1/-1;text-align:center;color:var(--muted)">data.json topilmadi. Fayllarni repo ildiziga to\'g\'ri joylaganingizni tekshiring.</p>'; });

document.getElementById('q').addEventListener('input', applyFilter);

// ---- Administrator: token shu brauzerda saqlanadi ----
function getCreds(){ try { return JSON.parse(localStorage.getItem('gh_creds')||'null'); } catch(e){ return null; } }
function setCreds(c){ try{ localStorage.setItem('gh_creds', JSON.stringify(c)); }catch(e){} }

function adminVisible(){
  return !!getCreds() || /[?&]admin=1(&|$)/.test(location.search);
}
if (adminVisible()) document.getElementById('adminBtn').classList.remove('hide');

document.getElementById('adminBtn').addEventListener('click', openPanel);
document.getElementById('close').addEventListener('click', function(){ document.getElementById('panel').classList.add('hide'); });

function openPanel(){
  var creds = getCreds();
  if (!creds){
    document.getElementById('credsBox').classList.remove('hide');
    document.getElementById('adminBody').classList.add('hide');
  } else {
    document.getElementById('credsBox').classList.add('hide');
    document.getElementById('adminBody').classList.remove('hide');
    renderBannerThumb(); renderCatChips(); renderRows(); renderContactRows();
    document.getElementById('addrInput').value = STORE.address || '';
  }
  document.getElementById('panel').classList.remove('hide');
}

document.getElementById('ghSave').addEventListener('click', function(){
  var owner=document.getElementById('ghOwner').value.trim();
  var repo=document.getElementById('ghRepo').value.trim();
  var token=document.getElementById('ghToken').value.trim();
  if (!owner || !repo || !token) return;
  setCreds({owner:owner, repo:repo, token:token});
  openPanel();
});
document.getElementById('ghLogout').addEventListener('click', function(){
  try{ localStorage.removeItem('gh_creds'); }catch(e){}
  openPanel();
});

function setStatus(msg){ var s=document.getElementById('status'); if (s) s.textContent = msg || ''; }

function renderBannerThumb(){
  var t = document.getElementById('bannerThumb'); t.innerHTML='';
  if (STORE.banner){ var im=document.createElement('img'); im.src=STORE.banner; im.style.width='100%'; im.style.height='100%'; im.style.objectFit='cover'; t.appendChild(im); }
  else { t.textContent='📷'; }
}
document.getElementById('bannerInput').addEventListener('change', function(){
  var input=this, file = input.files[0]; if (!file) return;
  setStatus('Rasm tayyorlanmoqda...');
  readAndResize(file, function(dataUrl){
    STORE.banner = dataUrl; renderBannerThumb(); setStatus("Rasm tanlandi. Saqlash tugmasini bosing.");
    input.value='';
  }, 900, function(){ setStatus("Rasmni o'qib bo'lmadi. Boshqa rasm tanlang."); input.value=''; });
});
document.getElementById('bannerClear').addEventListener('click', function(){
  STORE.banner=''; renderBannerThumb(); setStatus("Rasm olib tashlandi. Saqlash tugmasini bosing.");
});

function renderCatChips(){
  var el = document.getElementById('catChips'); el.innerHTML='';
  STORE.categories.forEach(function(k, i){
    var chip=document.createElement('span'); chip.className='chip';
    var txt=document.createElement('span'); txt.textContent=k;
    var del=document.createElement('button'); del.textContent='✕';
    del.addEventListener('click', function(){ STORE.categories.splice(i,1); renderCatChips(); renderRows(); });
    chip.appendChild(txt); chip.appendChild(del);
    el.appendChild(chip);
  });
}
document.getElementById('addCatBtn').addEventListener('click', function(){
  var inp = document.getElementById('newCat');
  var v = inp.value.trim();
  if (!v || STORE.categories.indexOf(v) !== -1) return;
  STORE.categories.push(v); inp.value='';
  renderCatChips(); renderRows();
});

document.getElementById('addRow').addEventListener('click', function(){
  STORE.products.push({name:'', price:0, cat:(STORE.categories[0]||'')});
  renderRows();
});

function renderRows(){
  var r = document.getElementById('rows'); r.innerHTML='';
  STORE.products.forEach(function(p, i){
    var row = document.createElement('div'); row.className='row';

    var pick=document.createElement('div'); pick.className='imgpick';
    var thumb=document.createElement('div'); thumb.className='thumb';
    if (p.img){ var im=document.createElement('img'); im.src=p.img; im.alt=''; thumb.appendChild(im); } else { thumb.textContent='📷'; }
    var lbl=document.createElement('label'); lbl.className='pickbtn small'; lbl.appendChild(document.createTextNode(p.img ? 'Almashtirish' : 'Rasm'));
    var finput=document.createElement('input'); finput.type='file'; finput.accept='image/*'; finput.hidden=true;
    finput.addEventListener('change', function(){
      var file=finput.files[0]; if (!file) return;
      setStatus('Rasm tayyorlanmoqda...');
      readAndResize(file, function(dataUrl){
        p.img=dataUrl; setStatus("Rasm tanlandi. Saqlash tugmasini bosing."); renderRows();
      }, 320, function(){ setStatus("Rasmni o'qib bo'lmadi. Boshqa rasm tanlang."); finput.value=''; });
    });
    lbl.appendChild(finput);
    thumb.addEventListener('click', function(){ finput.click(); });
    pick.appendChild(thumb); pick.appendChild(lbl);
    if (p.img){
      var clr=document.createElement('button'); clr.type='button'; clr.className='pickclear'; clr.textContent='Olib tashlash';
      clr.addEventListener('click', function(){ delete p.img; setStatus("Rasm olib tashlandi. Saqlash tugmasini bosing."); renderRows(); });
      pick.appendChild(clr);
    }

    var nameInp=document.createElement('input'); nameInp.type='text'; nameInp.placeholder='Nomi'; nameInp.value=p.name||'';
    nameInp.addEventListener('input', function(){ p.name=nameInp.value; });

    var priceInp=document.createElement('input'); priceInp.type='number'; priceInp.value=p.price||0;
    priceInp.addEventListener('input', function(){ p.price=Number(priceInp.value||0); });

    var sel=document.createElement('select');
    STORE.categories.forEach(function(k){
      var opt=document.createElement('option'); opt.value=k; opt.textContent=k;
      if (k===p.cat) opt.selected=true;
      sel.appendChild(opt);
    });
    sel.addEventListener('change', function(){ p.cat=sel.value; });

    var del=document.createElement('button'); del.className='del'; del.textContent='✕';
    del.addEventListener('click', function(){ STORE.products.splice(i,1); renderRows(); });

    row.appendChild(pick); row.appendChild(nameInp); row.appendChild(priceInp); row.appendChild(sel); row.appendChild(del);
    r.appendChild(row);
  });
}

document.getElementById('addContact').addEventListener('click', function(){
  STORE.contacts.push({name:'', phone:''});
  renderContactRows();
});

function renderContactRows(){
  var r = document.getElementById('contactRows'); r.innerHTML='';
  STORE.contacts.forEach(function(ct, i){
    var row=document.createElement('div'); row.className='row';
    var nameInp=document.createElement('input'); nameInp.type='text'; nameInp.placeholder='Ism'; nameInp.value=ct.name||'';
    nameInp.addEventListener('input', function(){ ct.name=nameInp.value; });
    var phoneInp=document.createElement('input'); phoneInp.type='tel'; phoneInp.placeholder='+998 90 123 45 67'; phoneInp.value=ct.phone||'';
    phoneInp.addEventListener('input', function(){ ct.phone=phoneInp.value; });
    var del=document.createElement('button'); del.className='del'; del.textContent='✕';
    del.addEventListener('click', function(){ STORE.contacts.splice(i,1); renderContactRows(); });
    row.appendChild(nameInp); row.appendChild(phoneInp); row.appendChild(del);
    r.appendChild(row);
  });
}

document.getElementById('addrInput').addEventListener('input', function(){ STORE.address = this.value; });

function saveToGithub(){
  var status = document.getElementById('status');
  var creds = getCreds();
  if (!creds){ status.textContent = "Administrator ma'lumotlari yo'q."; return; }
  status.textContent = 'Saqlanmoqda...';
  var api = 'https://api.github.com/repos/'+creds.owner+'/'+creds.repo+'/contents/data.json';
  fetch(api, { headers:{ 'Authorization':'token '+creds.token, 'Accept':'application/vnd.github+json' } })
    .then(function(r){ if(!r.ok) throw r.status; return r.json(); })
    .then(function(file){
      var json = JSON.stringify(STORE, null, 2);
      var content = btoa(unescape(encodeURIComponent(json)));
      return fetch(api, {
        method:'PUT',
        headers:{ 'Authorization':'token '+creds.token, 'Accept':'application/vnd.github+json', 'Content-Type':'application/json' },
        body: JSON.stringify({ message:'Yangilash '+new Date().toLocaleString(), content: content, sha: file.sha })
      });
    })
    .then(function(r){ if(!r.ok) throw r.status; return r.json(); })
    .then(function(){ status.textContent = "Saqlandi ✅ — bir necha soniyada saytda yangilanadi."; })
    .catch(function(err){
      status.textContent = (err===404) ? "data.json topilmadi — fayl nomini tekshiring." :
        (err===401 || err===403) ? "Token noto'g'ri yoki ruxsat yo'q." :
        (err===409 || err===422) ? "Fayl boshqa joyda yangilangan, sahifani qayta yuklang." :
        "Xatolik yuz berdi, qayta urinib ko'ring.";
    });
}
document.getElementById('save').addEventListener('click', function(){
  renderBanner(); renderCatButtons(); renderCards(); renderContactSection();
  saveToGithub();
});
</script>
